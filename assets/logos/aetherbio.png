@media (prefers-color-scheme: light) {
	option { color: black; }
}

img::selection {
	background: transparent;
}
/* Clear Defaults */
a:not([class]) {
	text-decoration: underline;
}
select:has(option[value=""]:checked) {
	color: color-mix(in lab, currentcolor 60%, transparent)
}
/* Selection Color */
::selection {
	background-color: var(--_ui-styles---selection--background);
	color: var(--_ui-styles---selection--text);
}
/* Rich Text Links */
.w-richtext a {
	position: relative;
	z-index: 4;
}
/* Hide */
.u-hide-if-empty:empty,
.u-hide-if-empty:not(:has(> :not(.w-condition-invisible))),
.u-hide-if-empty-cms:not(:has(.w-dyn-item)) {
	display: none !important;
}
/* Focus State */
a, button, :where([tabindex]), [data-outline], input {
	outline-offset: var(--_ui-styles---focus--offset-outer);
}
a:focus-visible,
button:focus-visible,
[tabindex]:focus-visible,
input:focus-visible {
	outline-color: var(--colors--white);
	outline-width: var(--_ui-styles---focus--offset-outer);
	outline-style: solid;
}
.w-pagination-next {
  all: unset;
}
/* Global / Clickable Component */
.wf-design-mode .clickable_wrap {
	z-index: 0;
  pointer-events: none;
  }
.clickable_wrap a[href="#"] {
	display: none;
  }
.clickable_wrap a[href="#"] ~ button {
	display: block;
  }

